# Copie para server/.env.test. Usado só por `npm run test:server` (see
# vitest.setup.ts) so the automated test suite — which truncates tables
# between tests (server/test/helpers.ts cleanDatabase) — never touches the
# same database as `npm run dev:server` / prisma:seed. Nunca commite
# server/.env.test de verdade.

# Casa com o segundo banco criado por docker/init-test-db.sql (ou, num volume
# já existente, `docker exec <container> psql -U agendamento -d agendamento -c
# "CREATE DATABASE agendamento_test OWNER agendamento;"`), então aplique as
# migrations nele: `npm run --workspace server prisma:migrate:test`.
DATABASE_URL="postgresql://agendamento:agendamento@localhost:5432/agendamento_test"

# Não usado de verdade em teste, mas exigido pelo schema de env (min 32
# caracteres) — qualquer valor serve.
JWT_SECRET="test-only-secret-not-used-for-anything-real"
