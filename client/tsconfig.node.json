{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    // Composite projects must emit, but colocating output next to source risks
    // Vite/Vitest's extensionless resolver picking up a stale compiled .js over
    // the .ts it was built from (bit us on middleware.ts, imported via
    // `import('./middleware')` in middleware.test.ts) — keep it out of the way.
    "outDir": "./.tsc-out"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "middleware.ts"]
}
