# Copie para client/.env e ajuste. Nunca commite client/.env de verdade.
# Só variáveis com prefixo VITE_ são expostas ao bundle do browser — nunca
# coloque segredo aqui, o valor vai parar em texto plano no JS servido.

# URL base da API (sem barra final). Em dev, aponta pro server local; em
# produção, precisa ser a URL pública do backend no Render/Railway.
VITE_API_URL="http://localhost:3000"
